# Server-only key for Mirsad's course advisor. Configure as a Sites secret.
MIRSAD_OPENAI_API_KEY=

# Required to enable live Civil AI responses.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5-mini for a responsive chat experience.
OPENAI_MODEL=gpt-5-mini

# Optional. Used by the scheduled second-pass fact review; defaults to
# OPENAI_MODEL and then gpt-5-mini.
OPENAI_REVIEW_MODEL=gpt-5-mini

# Server-only values used by scripts/sync-opportunities.mjs. Keep the service
# role key in GitHub Actions Secrets and never expose it to browser code.
SUPABASE_URL=https://crqjtgolagrknjkpbsdi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Catalog bot: deterministic official-source checks, without AI API calls.
# Set to ai only after provisioning the separate review credentials.
BOT_VERIFICATION_MODE=official_source

# Optional social read APIs. YouTube's verified public feeds need no API key.
# X requires an authorized developer application with timeline read access.
X_BEARER_TOKEN=
# Instagram Business Discovery (Facebook Login) requires a linked professional
# account and appropriate Meta permissions. Set a supported Graph API version.
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=

# Public browser credentials for the Mirsad catalog. Publishable keys are safe
# to expose; never add a Supabase service-role key to this repository.
NEXT_PUBLIC_SUPABASE_URL=https://crqjtgolagrknjkpbsdi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
